<Window x:Class="Sharksweeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hello World Investigation" Width="520" Height="280"
    Background="#0A202B">
    <StackPanel Margin="28">
        <TextBlock Text="Greeting, fishers."
                   Foreground="#EFD09B" FontSize="18" />
        <TextBlock x:Name="MessageText" Text="Ready to fish?"
                   Foreground="White" FontSize="24"
                   TextWrapping="Wrap" Margin="0,20,0,20" />
        <Button x:Name="FishButton" Content="Start fishing"
                Click="fish_Click" Padding="12,8"
                HorizontalAlignment="Left" />
    </StackPanel>
</Window>